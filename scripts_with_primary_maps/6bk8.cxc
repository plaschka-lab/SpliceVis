select #423.1/6:1-30
nucleotides sel fill
select clear
# U2/U6 helix I: residues 41-66
color #423.1/6:41-66 #D0183C
select #423.1/6:41-66
nucleotides sel fill
select clear
# U6 5'SS contact: residues 44-55
color #423.1/6:44-55 #E01842
select #423.1/6:44-55
nucleotides sel fill
select clear
# U6 ISL: residues 46-73
