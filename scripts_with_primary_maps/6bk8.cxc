nucleotides sel fill
select clear
# U6 AGC triad: residues 59-61
color #423.1/6:59-61 #C91236
select #423.1/6:59-61
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #423.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/6bk8_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/6bk8_selection_browser.py
# Compact annotated pre-mRNA alignment; clicking modelled residues focuses them in ChimeraX.
open https://plaschka-lab.github.io/SpliceVis/rna_references/6bk8_vs_act1_mv_679.modelled.html?viewer=chimerax
view
show nucleic
