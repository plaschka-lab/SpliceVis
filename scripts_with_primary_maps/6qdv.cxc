nucleotides sel fill
select clear
# U2 BP pairing: residues 32-41
color #420.1/2:32-41 #0B6E2D
select #420.1/2:32-41
nucleotides sel fill
select clear
# U2 stem IIa: residues 46-60
color #420.1/2:46-60 #167A38
select #420.1/2:46-60
nucleotides sel fill
select clear
# U5 loop I: residues 38-42
color #420.1/5:38-42 #1B3CD0
select #420.1/5:38-42
nucleotides sel fill
select clear
# U6 5' terminal SL: residues 1-30
color #420.1/6:1-30 #DC143C
select #420.1/6:1-30
nucleotides sel fill
select clear
# U2/U6 helix I: residues 35-60
color #420.1/6:35-60 #D0183C
select #420.1/6:35-60
nucleotides sel fill
select clear
# U6 5'SS contact: residues 38-49
color #420.1/6:38-49 #E01842
select #420.1/6:38-49
nucleotides sel fill
select clear
# U6 ACAGAGA: residues 41-47
color #420.1/6:41-47 #DC143C
select #420.1/6:41-47
nucleotides sel fill
select clear
# U6 ISL: residues 79-97
color #420.1/6:79-97 #D61A3D
select #420.1/6:79-97
nucleotides sel fill
select clear
# U6 AGC triad: residues 92-94
color #420.1/6:92-94 #C91236
select #420.1/6:92-94
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #420.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/6qdv_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/6qdv_selection_browser.py
view
show nucleic
