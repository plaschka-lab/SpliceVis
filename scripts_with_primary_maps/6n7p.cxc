# Lightweight ChimeraX script for 6N7P
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Original deposited chain identifiers are used.

# Shared anchor frame: 8H6L
# Structure group: #330; target model: #330.1; RNA labels: #330.2.

open 8h6l id 330.9 name 8H6L_anchor
open 6n7p id 330.1 name 6N7P
open emdb:0360 id 330.3.1 name E_complex_6n7p_EMD-0360_primary_map
rename #330 E_complex_6n7p_structure

# No PRPF8 or SF3B1 chain was detected; anchor is closed without alignment.
close #330.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# SNRNP70
color #330.1/A #8C3D78
# SNRPC
color #330.1/B #D7A3CF
# SNRPA
color #330.1/C #C07AB6
# PRP42
color #330.1/D #7F5BA6
# PRPF39
color #330.1/E #E1B8D9
# NAM8
color #330.1/F #C7A6BE
# SNU56
color #330.1/G #D65B96
# SNU71
color #330.1/H #A95A9B
# LUC7L
color #330.1/I #B03372
# PRPF40A
color #330.1/J #BA6FA8
# U1-Sm SNRPB
color #330.1/K #EAD7E8
# U1-Sm SNRPD1
color #330.1/L #EAD7E8
# U1-Sm SNRPD2
color #330.1/M #EAD7E8
# U1-Sm SNRPD3
color #330.1/N #EAD7E8
# U1-Sm SNRPE
color #330.1/O #EAD7E8
# U1-Sm SNRPF
color #330.1/P #EAD7E8
# U1-Sm SNRPG
color #330.1/Q #EAD7E8
# U1 snRNA
color #330.1/R #D46BB8
# mRNA
color #330.1/r #303030
# CBP80
color #330.1/X #B29876
# CBP20
color #330.1/Y #547596
# Named selections for subcomplexes using original deposited chain IDs.
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_6N7P_RNA_substrate #330.1/r
# U1 Sm ring
# selector_meta {"color":"#B66AAE","family":"Protein/RNP groups","group":"U1 snRNP groups","kind":"subcomplex"}
name pdb_6N7P_U1_Sm_ring #330.1/K,L,M,N,O,P,Q
# U1 snRNP
# selector_meta {"color":"#B66AAE","family":"Protein/RNP groups","group":"U1 snRNP groups","kind":"subcomplex"}
name pdb_6N7P_U1_snRNP #330.1/A,B,C,D,E,F,G,H,I,J,R
# other
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_6N7P_other #330.1/X,Y
# Named selections for resolved substrate RNA features.
# 5' exon: residues -9--1, splice-site-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#FF9D00","family":"RNA","feature":"exon_5","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name E_complex_6N7P_5exon #330.1/r:-9--1
# 5' splice site: residues 1-6, network-scored-motif, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"five_prime_splice_site","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name E_complex_6N7P_5SS #330.1/r:1-6
# intron: residues 1-13, splice-site-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#303030","family":"RNA","feature":"intron","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name E_complex_6N7P_intron #330.1/r:1-13
# Named selections for resolved snRNA functional regions.
# U1 snRNA 5' splice-site recognition region: residues 1-10, review-region, medium confidence
# selector_meta {"color":"#B66AAE","family":"RNA","feature":"U1_5prime_5SS_recognition","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name E_complex_6N7P_U1_5_5SS_recognition #330.1/R:1-10
# U1 snRNA stem-loop 1: residues 11-26;34-45, review-region, low confidence
# selector_meta {"color":"#BF72B7","family":"RNA","feature":"U1_SL1","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name E_complex_6N7P_U1_SL1 #330.1/R:11-26,34-45
# U1 snRNA stem-loop 2: residues 46-95, review-region, low confidence
# selector_meta {"color":"#AD62A6","family":"RNA","feature":"U1_SL2","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name E_complex_6N7P_U1_SL2 #330.1/R:46-95
# U1 snRNA Sm site: residues 224-230; 241-247; 553-559, sequence-motif, medium confidence
# selector_meta {"color":"#C783BF","family":"RNA","feature":"U1_Sm_site","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name E_complex_6N7P_U1_Sm_site #330.1/R:224-230|#330.1/R:241-247|#330.1/R:553-559
# RNA feature nucleotide display.
select #330.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues -9--1
color #330.1/r:-9--1 #FF9D00
select #330.1/r:-9--1
nucleotides sel fill
select clear
# 5'SS: residues 1-6
# intron: residues 1-13
# U1 5'SS recog.: residues 1-10
color #330.1/R:1-10 #B66AAE
select #330.1/R:1-10
nucleotides sel fill
select clear
# U1 SL1: residues 11-26;34-45
color #330.1/R:11-26,34-45 #BF72B7
select #330.1/R:11-26,34-45
nucleotides sel fill
select clear
# U1 SL2: residues 46-95
color #330.1/R:46-95 #AD62A6
select #330.1/R:46-95
nucleotides sel fill
select clear
# U1 Sm site: residues 224-230; 241-247; 553-559
color #330.1/R:224-230|#330.1/R:241-247|#330.1/R:553-559 #C783BF
select #330.1/R:224-230|#330.1/R:241-247|#330.1/R:553-559
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #330.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/6n7p_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/6n7p_selection_browser.py
# Compact annotated pre-mRNA alignment; clicking modelled residues focuses them in ChimeraX.
open https://plaschka-lab.github.io/SpliceVis/rna_references/6n7p_vs_ubc4_mv_253.modelled.html?viewer=chimerax
view
show nucleic
