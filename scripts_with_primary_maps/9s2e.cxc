color #433.1/5:38-42 #1B3CD0
select #433.1/5:38-42
nucleotides sel fill
select clear
# U6 5' terminal SL: residues 1-30
color #433.1/6:1-30 #DC143C
select #433.1/6:1-30
nucleotides sel fill
select clear
# U2/U6 helix I: residues 35-60
color #433.1/6:35-60 #D0183C
select #433.1/6:35-60
nucleotides sel fill
select clear
# U6 5'SS contact: residues 38-49
color #433.1/6:38-49 #E01842
select #433.1/6:38-49
nucleotides sel fill
select clear
# U6 ACAGAGA: residues 41-47
color #433.1/6:41-47 #DC143C
