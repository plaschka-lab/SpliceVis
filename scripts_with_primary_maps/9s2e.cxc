nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #433.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/9s2e_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/9s2e_selection_browser.py
view
show nucleic
