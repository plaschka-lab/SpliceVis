color #433.1/YB #DA70D6
# CCDC12
color #433.1/Z #FAEBD7
# U5-Sm SNRPD3
color #433.1/a #B0C4DE
# U5-Sm SNRPB
color #433.1/b #B0C4DE
# U5-Sm SNRPD1
color #433.1/c #B0C4DE
# U5-Sm SNRPD2
color #433.1/d #B0C4DE
# U5-Sm SNRPE
color #433.1/e #B0C4DE
# U5-Sm SNRPF
color #433.1/f #B0C4DE
# U5-Sm SNRPG
color #433.1/g #B0C4DE
