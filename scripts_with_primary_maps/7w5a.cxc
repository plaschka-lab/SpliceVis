nucleotides sel fill
select clear
# U6 AGC triad: residues 53-55
color #419.1/F:53-55 #C91236
select #419.1/F:53-55
nucleotides sel fill
select clear
# U6 ISL: residues 56-79
color #419.1/F:56-79 #D61A3D
select #419.1/F:56-79
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #419.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/7w5a_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/7w5a_selection_browser.py
view
show nucleic
