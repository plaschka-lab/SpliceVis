# Lightweight ChimeraX script for 7ABF
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Original deposited chain identifiers are used.

# Shared anchor frame: 8H6L
# Structure group: #373; target model: #373.1; RNA labels: #373.2.

open 8h6l id 373.9 name 8H6L_anchor
open 7abf id 373.1 name 7ABF
open emdb:11694 id 373.3.1 name pre_Bact_7abf_EMD-11694_primary_map
rename #373 pre_Bact_7abf_structure

# Align on PRPF8.
matchmaker #373.1/A to #373.9/5B bring #373.3.1
close #373.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# BUD31
color #373.1/Q #FFF584
# PRPF38A
color #373.1/I #F88379
# PRPF8
color #373.1/A #BFC3E8
# EFTUD2
color #373.1/r #6495ED
# ZMAT2
color #373.1/N #FFB6C1
# UBL5
color #373.1/q #DB7093
# CWC15
color #373.1/R #FFDEAD
# U5 snRNA
color #373.1/5 #4F9FD3
# U6 snRNA
color #373.1/6 #EF4444
# NPWBP
color #373.1/X #D8944F
# SNW1
color #373.1/v #D49F96
# PLRG1
color #373.1/G #F4A460
# mRNA
color #373.1/Z #303030
# MFAP1
color #373.1/K #CD5C5C
# CA150
color #373.1/A4 #A2B8CD
# Named selections for subcomplexes using original deposited chain IDs.
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_7ABF_NTC_NTR_related #373.1/Q,v
# NTC/PRP19
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_7ABF_NTC_PRP19 #373.1/G,R
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_7ABF_RNA_substrate #373.1/Z
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_7ABF_U5_snRNP #373.1/5,A,r
# U6 snRNP
# selector_meta {"color":"#DC143C","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_7ABF_U6_snRNP #373.1/6
# other
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_7ABF_other #373.1/A4,I,K,N,X,q
# Named selections for resolved substrate RNA features.
# 5' exon: residues 50-58, splice-site-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#FF9D00","family":"RNA","feature":"exon_5","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name pre_Bact_7ABF_5exon #373.1/Z:50-58
# 5' splice site: residues 59-64, network-scored-motif, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"five_prime_splice_site","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name pre_Bact_7ABF_5SS #373.1/Z:59-64
# intron: residues 59-78, splice-site-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#303030","family":"RNA","feature":"intron","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name pre_Bact_7ABF_intron #373.1/Z:59-78
# Named selections for resolved snRNA functional regions.
# U5 snRNA loop I: residues 38-42, sequence-motif, medium confidence
# selector_meta {"color":"#1B3CD0","family":"RNA","feature":"U5_loop_I","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name pre_Bact_7ABF_U5_loop_I #373.1/5:38-42
# U6 snRNA 5' terminal stem-loop: residues 1-30, reference-alignment, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6_5prime_terminal_stem_loop","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name pre_Bact_7ABF_U6_5_terminal_stem_loop #373.1/6:1-30
# U6 snRNA U2/U6 helix I partner: residues 35-46;58-60, motif-neighborhood, medium confidence
# selector_meta {"color":"#D0183C","family":"RNA","feature":"U6_U2_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name pre_Bact_7ABF_U6_U2_helix_I_partner #373.1/6:35-46,58-60
# U6 snRNA 5' splice-site upstream contact: residues 38-46, motif-neighborhood, medium confidence
# selector_meta {"color":"#E01842","family":"RNA","feature":"U6_5SS_upstream_contact","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name pre_Bact_7ABF_U6_5SS_upstream_contact #373.1/6:38-46
# U6 snRNA ACAGAGA box: residues 41-46, sequence-motif, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6_ACAGAGA_box","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name pre_Bact_7ABF_U6_ACAGAGA_box #373.1/6:41-46
# U6 snRNA internal stem-loop core: residues 58-76, reference-alignment, medium confidence
# selector_meta {"color":"#D61A3D","family":"RNA","feature":"U6_ISL","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name pre_Bact_7ABF_U6_ISL #373.1/6:58-76
# RNA feature nucleotide display.
select #373.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues 50-58
color #373.1/Z:50-58 #FF9D00
select #373.1/Z:50-58
nucleotides sel fill
select clear
# 5'SS: residues 59-64
# intron: residues 59-78
# U5 loop I: residues 38-42
color #373.1/5:38-42 #1B3CD0
select #373.1/5:38-42
nucleotides sel fill
select clear
# U6 5' terminal SL: residues 1-30
color #373.1/6:1-30 #DC143C
select #373.1/6:1-30
nucleotides sel fill
select clear
# U2/U6 helix I: residues 35-46;58-60
color #373.1/6:35-46,58-60 #D0183C
select #373.1/6:35-46,58-60
nucleotides sel fill
select clear
# U6 5'SS contact: residues 38-46
color #373.1/6:38-46 #E01842
select #373.1/6:38-46
nucleotides sel fill
select clear
# U6 ACAGAGA: residues 41-46
color #373.1/6:41-46 #DC143C
select #373.1/6:41-46
nucleotides sel fill
select clear
# U6 ISL: residues 58-76
color #373.1/6:58-76 #D61A3D
select #373.1/6:58-76
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #373.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/7abf_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/7abf_selection_browser.py
# Compact annotated pre-mRNA alignment; clicking modelled residues focuses them in ChimeraX.
open https://plaschka-lab.github.io/SpliceVis/rna_references/7abf_vs_minx_m3_324.modelled.html?viewer=chimerax
view
show nucleic
