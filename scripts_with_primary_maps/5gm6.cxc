color #380.1/V #5FB491
# BUD13
color #380.1/W #459285
# DBP2
color #380.1/Y #E3B296
# CWC22
color #380.1/Z #2C54DD
# CWC27
color #380.1/b #806ED8
# CDC5L
color #380.1/c #DAA520
# SF3B1
color #380.1/G #D5EAD0
# CRNKL1
color #380.1/d #FFC388
# SRRM2
color #380.1/X #BDD6F0
# SYF1
color #380.1/v #FF957B
# SF3B4
color #380.1/e #77B088
# SYF2
color #380.1/f #FF8C00
# PRPF19
color #380.1/o #FFFFAB
# PRPF19
color #380.1/p #FFFFAB
# PRPF19
color #380.1/q #FFFFAB
# PRPF19
color #380.1/r #FFFFAB
# BCAS2
color #380.1/t #FFDAB9
# PRPF17
color #380.1/n #FFF7C9
# SNRPB
color #380.1/k #B0C4DE
# SNRPE
color #380.1/i #B0C4DE
# SNRPF
color #380.1/h #B0C4DE
