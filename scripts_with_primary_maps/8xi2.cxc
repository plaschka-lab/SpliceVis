# Lightweight ChimeraX script for 8XI2
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Original deposited chain identifiers are used.

# Shared anchor frame: 8H6L
# Structure group: #422; target model: #422.1; RNA labels: #422.2.

open 8h6l id 422.9 name 8H6L_anchor
open 8xi2 id 422.1 name 8XI2
open emdb:38362 id 422.3.1 name Cstar_8xi2_EMD-38362_primary_map
rename #422 Cstar_8xi2_structure

# Align on PRPF8.
matchmaker #422.1/A to #422.9/5B bring #422.3.1
close #422.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# PRPF8
color #422.1/A #BFC3E8
# U5 snRNA
color #422.1/B #4F9FD3
# EFTUD2
color #422.1/C #6495ED
# PRP8BP
color #422.1/E #E2F3F4
# U6 snRNA
color #422.1/F #EF4444
# PRPF19
color #422.1/q #FFFFAB
# PRPF19
color #422.1/r #FFFFAB
# PRPF19
color #422.1/s #FFFFAB
# PRPF19
color #422.1/t #FFFFAB
# U5-Sm SNRPD3
color #422.1/a #A9CFE8
# U5-Sm SNRPG
color #422.1/g #A9CFE8
# U5-Sm SNRPE
color #422.1/e #A9CFE8
# U5-Sm SNRPF
color #422.1/f #A9CFE8
# U5-Sm SNRPD2
color #422.1/d #A9CFE8
# U5-Sm SNRPD1
color #422.1/c #A9CFE8
# U5-Sm SNRPB
color #422.1/b #A9CFE8
# SYF1
color #422.1/I #FF957B
# CRNKL1
color #422.1/J #FFC388
# CWC15
color #422.1/P #FFDEAD
# SYF2
color #422.1/M #FF8C00
# PLRG1
color #422.1/T #F4A460
# RBM22
color #422.1/O #DE9A52
# BUD31
color #422.1/N #FFF584
# SNW1
color #422.1/R #D49F96
# U2 snRNA
color #422.1/H #71C562
# PPIL1
color #422.1/S #EEE8AA
# PRPF17
color #422.1/W #FFF7C9
# CDC5L
color #422.1/L #DAA520
# BCAS2
color #422.1/K #FFDAB9
# SRRM2
color #422.1/U #BDD6F0
# CWC22
color #422.1/V #2C54DD
# AQR
color #422.1/Q #FFDAB9
# mRNA
color #422.1/5 #303030
# INTRON
color #422.1/3 #303030
# Named selections for subcomplexes using original deposited chain IDs.
# EJC/mRNP
# selector_meta {"color":"#EAA439","family":"Protein/RNP groups","group":"EJC/mRNP groups","kind":"subcomplex"}
name pdb_8XI2_EJC_mRNP #422.1/V
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_8XI2_NTC_NTR_related #422.1/I,J,M,N,O,Q,R,S
# NTC/PRP19
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_8XI2_NTC_PRP19 #422.1/K,L,P,T,q,r,s,t
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_8XI2_RNA_substrate #422.1/3,5
# SR proteins
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_8XI2_SR_proteins #422.1/U
# Second step factors
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_8XI2_Second_step_factors #422.1/W
# U2 snRNP
# selector_meta {"color":"#2F8B4D","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_8XI2_U2_snRNP #422.1/H
# U5 Sm ring
# selector_meta {"color":"#BFC3E8","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_8XI2_U5_Sm_ring #422.1/a,b,c,d,e,f,g
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_8XI2_U5_snRNP #422.1/A,B,C,E
# U6 snRNP
# selector_meta {"color":"#DC143C","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_8XI2_U6_snRNP #422.1/F
# Named selections for resolved substrate RNA features.
# 5-prime exon: residues -7--1, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#FF9D00","family":"RNA","feature":"exon_5","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Cstar_8XI2_5exon #422.1/5:-7--1
# Intron: residues 1-22;90-101, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"intron","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Cstar_8XI2_intron #422.1/3:1-22,90-101
# 5-prime splice site: residues 1-6, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"five_prime_splice_site","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Cstar_8XI2_5SS #422.1/3:1-6
# Named selections for resolved snRNA functional regions.
# U2 snRNA Branch-helix region: residues 33-40, paper-curated, high confidence
# selector_meta {"color":"#0B6E2D","family":"RNA","feature":"U2_branchpoint_pairing_region","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name Cstar_8XI2_U2_branchpoint_pairing_region #422.1/H:33-40
# U5 snRNA Loop I / 5-prime exon contact: residues 40-46, paper-curated, high confidence
# selector_meta {"color":"#1B3CD0","family":"RNA","feature":"U5_loop_I","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name Cstar_8XI2_U5_loop_I #422.1/B:40-46
# U6 snRNA 5-prime terminal stem-loop: residues 1-12, paper-curated, high confidence
# selector_meta {"color":"#9CA3AF","family":"RNA","feature":"U6_5prime_stem_loop","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name Cstar_8XI2_U6_5_stem_loop #422.1/F:1-12
# U6 snRNA ACAGAGA box: residues 34-40, paper-curated, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6_ACAGAGA_box","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name Cstar_8XI2_U6_ACAGAGA_box #422.1/F:34-40
# U6 snRNA Catalytic AGC triad: residues 46-48, paper-curated, high confidence
# selector_meta {"color":"#C91236","family":"RNA","feature":"U6_AGC_catalytic_triad","group":"catalytic core regions","group_key":"catalytic_core_regions","kind":"rna_feature"}
name Cstar_8XI2_U6_AGC_catalytic_triad #422.1/F:46-48
# U6 snRNA Catalytic U67: residues 67, paper-curated, high confidence
# selector_meta {"color":"#9CA3AF","family":"RNA","feature":"U6_catalytic_U","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name Cstar_8XI2_U6_catalytic_U #422.1/F:67
# RNA feature nucleotide display.
select #422.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues -7--1
color #422.1/5:-7--1 #FF9D00
select #422.1/5:-7--1
nucleotides sel fill
select clear
# intron: residues 1-22;90-101
# 5'SS: residues 1-6
# U2 BP pairing: residues 33-40
color #422.1/H:33-40 #0B6E2D
select #422.1/H:33-40
nucleotides sel fill
select clear
# U5 loop I: residues 40-46
color #422.1/B:40-46 #1B3CD0
select #422.1/B:40-46
nucleotides sel fill
select clear
# 5-prime terminal stem-loop: residues 1-12
color #422.1/F:1-12 #F97316
select #422.1/F:1-12
nucleotides sel fill
select clear
# U6 ACAGAGA: residues 34-40
color #422.1/F:34-40 #DC143C
select #422.1/F:34-40
nucleotides sel fill
select clear
# U6 AGC triad: residues 46-48
color #422.1/F:46-48 #C91236
select #422.1/F:46-48
nucleotides sel fill
select clear
# Catalytic U67: residues 67
color #422.1/F:67 #F97316
select #422.1/F:67
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #422.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/8xi2_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/8xi2_selection_browser.py
view
show nucleic
