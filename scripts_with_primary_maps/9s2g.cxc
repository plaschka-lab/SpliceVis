# Lightweight ChimeraX script for 9S2G
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Original deposited chain identifiers are used.

# Shared anchor frame: 8H6L
# Structure group: #404; target model: #404.1; RNA labels: #404.2.

open 8h6l id 404.9 name 8H6L_anchor
open 9s2g id 404.1 name 9S2G
open emdb:19942 id 404.3.1 name BstarD_9s2g_EMD-19942_primary_map
rename #404 BstarD_9s2g_structure

# Align on PRPF8.
matchmaker #404.1/A to #404.9/5B bring #404.3.1
close #404.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# mRNA
color #404.1/1 #303030
# U2 snRNA
color #404.1/2 #71C562
# DHX35
color #404.1/35 #78184A
# U5 snRNA
color #404.1/5 #4F9FD3
# U6 snRNA
color #404.1/6 #EF4444
# PRPF8
color #404.1/A #BFC3E8
# EFTUD2
color #404.1/C #6495ED
# CWC22
color #404.1/CW #2C54DD
# PRP8BP
color #404.1/E #E2F3F4
# GPATCH1
color #404.1/GP #E52B75
# SYF1
color #404.1/I #FF957B
# CRNKL1
color #404.1/J #FFC388
# BCAS2
color #404.1/K #FFDAB9
# CDC5L
color #404.1/L #DAA520
# LENG1
color #404.1/LG #9966CC
# U2-Sm SNRPF
color #404.1/M #D5F5E3
# BUD31
color #404.1/N #FFF584
# RBM22
color #404.1/O #DE9A52
# PRPF3
color #404.1/O2 #E1DD1B
# CWC15
color #404.1/P #FFDEAD
# PAXBP1
color #404.1/PX #FFC0CB
# AQR
color #404.1/Q #FFDAB9
# SNW1
color #404.1/R #D49F96
# PPIL1
color #404.1/S #EEE8AA
# SRRM2
color #404.1/SR #BDD6F0
# DDX46
color #404.1/T #5BAE8A
# TFIP11
color #404.1/TF #FF69B4
# PRPF17
color #404.1/W #FFF7C9
# CCDC94
color #404.1/YB #CE4678
# CCDC12
color #404.1/Z #FAEBD7
# U5-Sm SNRPD3
color #404.1/a #B0C4DE
# U5-Sm SNRPB
color #404.1/b #B0C4DE
# U5-Sm SNRPD1
color #404.1/c #B0C4DE
# U5-Sm SNRPD2
color #404.1/d #B0C4DE
# U5-Sm SNRPE
color #404.1/e #B0C4DE
# U5-Sm SNRPF
color #404.1/f #B0C4DE
# U5-Sm SNRPG
color #404.1/g #B0C4DE
# PRPF19
color #404.1/q #FFFFAB
# PRPF19
color #404.1/r #FFFFAB
# PRPF19
color #404.1/s #FFFFAB
# PRPF19
color #404.1/t #FFFFAB
# Named selections for subcomplexes using original deposited chain IDs.
# Disassembly factors
# selector_meta {"color":"#FF69B4","family":"Protein/RNP groups","group":"disassembly factors","kind":"subcomplex"}
name pdb_9S2G_Disassembly_factors #404.1/35,GP,PX,TF
# EJC/mRNP
# selector_meta {"color":"#EAA439","family":"Protein/RNP groups","group":"EJC/mRNP groups","kind":"subcomplex"}
name pdb_9S2G_EJC_mRNP #404.1/CW
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_9S2G_NTC_NTR_related #404.1/I,J,N,O,Q,R,S
# NTC/PRP19
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_9S2G_NTC_PRP19 #404.1/K,L,P,q,r,s,t
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_9S2G_RNA_substrate #404.1/1
# SR proteins
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9S2G_SR_proteins #404.1/SR
# Second step factors
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9S2G_Second_step_factors #404.1/W
# U2 Sm ring
# selector_meta {"color":"#BFE6BF","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_9S2G_U2_Sm_ring #404.1/M
# U2 snRNP
# selector_meta {"color":"#2F8B4D","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_9S2G_U2_snRNP #404.1/2,T,YB
# U4/U6 snRNP
# selector_meta {"color":"#C3BA7A","family":"Protein/RNP groups","group":"U4/U6 groups","kind":"subcomplex"}
name pdb_9S2G_U4_U6_snRNP #404.1/O2
# U5 Sm ring
# selector_meta {"color":"#BFC3E8","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_9S2G_U5_Sm_ring #404.1/a,b,c,d,e,f,g
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_9S2G_U5_snRNP #404.1/5,A,C,E
# U6 snRNP
# selector_meta {"color":"#DC143C","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_9S2G_U6_snRNP #404.1/6
# other
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9S2G_other #404.1/3,LG,Z
# Named selections for resolved substrate RNA features.
# 5' exon: residues -15-0, five-ss-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#FF9D00","family":"RNA","feature":"exon_5","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name BstarD_complex_9S2G_5exon #404.1/1:-15-0
# 5' splice site: residues 1-6, network-scored-motif, medium confidence, validation uncertain uncertain validation
# selector_meta {"color":"#303030","family":"RNA","feature":"five_prime_splice_site","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name BstarD_complex_9S2G_5SS #404.1/1:1-6
# intron from 5' splice site: residues 1-14, five-ss-inference, low confidence, validation not_applicable
# selector_meta {"color":"#303030","family":"RNA","feature":"intron","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name BstarD_complex_9S2G_intron #404.1/1:1-14
# Named selections for resolved snRNA functional regions.
# U2 snRNA U2/U6 helix I partner: residues 26-30, review-region, high confidence
# selector_meta {"color":"#047857","family":"RNA","feature":"U2_U6_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name BstarD_complex_9S2G_U2_U6_helix_I_partner #404.1/2:26-30
# U5 snRNA loop I: residues 47-51, sequence-motif, medium confidence
# selector_meta {"color":"#1B3CD0","family":"RNA","feature":"U5_loop_I","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name BstarD_complex_9S2G_U5_loop_I #404.1/5:47-51
# U6 snRNA U2/U6 helix I partner: residues 29-54, motif-neighborhood, medium confidence
# selector_meta {"color":"#D0183C","family":"RNA","feature":"U6_U2_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name BstarD_complex_9S2G_U6_U2_helix_I_partner #404.1/6:29-54
# U6 snRNA 5' splice-site upstream contact: residues 32-43, motif-neighborhood, medium confidence
# selector_meta {"color":"#E01842","family":"RNA","feature":"U6_5SS_upstream_contact","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name BstarD_complex_9S2G_U6_5SS_upstream_contact #404.1/6:32-43
# U6 snRNA ACAGAGA box: residues 35-41, sequence-motif, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6_ACAGAGA_box","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name BstarD_complex_9S2G_U6_ACAGAGA_box #404.1/6:35-41
# RNA feature nucleotide display.
select #404.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues -15-0
color #404.1/1:-15-0 #FF9D00
select #404.1/1:-15-0
nucleotides sel fill
select clear
# 5'SS: residues 1-6
# intron: residues 1-14
# U2/U6 helix I: residues 26-30
color #404.1/2:26-30 #047857
select #404.1/2:26-30
nucleotides sel fill
select clear
# U5 loop I: residues 47-51
color #404.1/5:47-51 #1B3CD0
select #404.1/5:47-51
nucleotides sel fill
select clear
# U2/U6 helix I: residues 29-54
color #404.1/6:29-54 #D0183C
select #404.1/6:29-54
nucleotides sel fill
select clear
# U6 5'SS contact: residues 32-43
color #404.1/6:32-43 #E01842
select #404.1/6:32-43
nucleotides sel fill
select clear
# U6 ACAGAGA: residues 35-41
color #404.1/6:35-41 #DC143C
select #404.1/6:35-41
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #404.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/9s2g_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/9s2g_selection_browser.py
view
show nucleic
