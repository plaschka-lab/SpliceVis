# Lightweight ChimeraX script for 7DVQ
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Original deposited chain identifiers are used.

# Shared anchor frame: 8H6L
# Structure group: #388; target model: #388.1; RNA labels: #388.2.

open 8h6l id 388.9 name 8H6L_anchor
open 7dvq id 388.1 name 7DVQ
rename #388 Bact_7dvq_structure

# Align on PRPF8.
matchmaker #388.1/A to #388.9/5B
close #388.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# PRPF8
color #388.1/A #BFC3E8
# U5 snRNA
color #388.1/B #4F9FD3
# EFTUD2
color #388.1/C #6495ED
# SNRNP200
color #388.1/D #AFEEEE
# PRP8BP
color #388.1/E #E2F3F4
# U5-Sm SNRPD3
color #388.1/a #B0C4DE
# U2-Sm SNRPD3
color #388.1/h #D5F5E3
# U5-Sm SNRPB
color #388.1/b #B0C4DE
# U2-Sm SNRPB
color #388.1/i #D5F5E3
# U5-Sm SNRPD1
color #388.1/c #B0C4DE
# U2-Sm SNRPD1
color #388.1/j #D5F5E3
# U5-Sm SNRPD2
color #388.1/d #B0C4DE
# U2-Sm SNRPD2
color #388.1/k #D5F5E3
# U5-Sm SNRPF
color #388.1/f #B0C4DE
# U2-Sm SNRPF
color #388.1/m #D5F5E3
# U5-Sm SNRPE
color #388.1/e #B0C4DE
# U2-Sm SNRPE
color #388.1/l #D5F5E3
# U5-Sm SNRPG
color #388.1/g #B0C4DE
# U2-Sm SNRPG
color #388.1/n #D5F5E3
# U6atac snRNA
color #388.1/F #EF4444
# mRNA
color #388.1/G #303030
# U12 snRNA
color #388.1/H #71C562
# SCNM1
color #388.1/v #A0916A
# SF3B1
color #388.1/1 #D5EAD0
# SF3B2
color #388.1/2 #49926C
# SF3B3
color #388.1/3 #487957
# SF3B4
color #388.1/4 #77B088
# SF3B6
color #388.1/5 #ADCEA0
# PHF5A
color #388.1/6 #375A40
# SF3B5
color #388.1/7 #92BB8F
# CDC5L
color #388.1/L #DAA520
# CRNKL1
color #388.1/J #FFC388
# CWC15
color #388.1/P #FFDEAD
# SNW1
color #388.1/R #D49F96
# PLRG1
color #388.1/T #F4A460
# SNIP1
color #388.1/X #89BFC8
# CGI-79
color #388.1/Y #5FB491
# BUD13
color #388.1/Z #459285
# PPIL2
color #388.1/9 #B12F50
# CWC27
color #388.1/z #806ED8
# DBP2
color #388.1/x #E3B296
# GPATC5
color #388.1/y #BFC4EE
# RNF113
color #388.1/M #6C46CE
# SRRM2
color #388.1/U #BDD6F0
# CWC22
color #388.1/V #2C54DD
# SRM160
color #388.1/8 #6E96C4
# CRIPT
color #388.1/0 #6A90A0
# C7ORF64
color #388.1/I #C7B8A8
# ARMC7
color #388.1/K #546383
# Named selections for subcomplexes using original deposited chain IDs.
# EJC/mRNP
# selector_meta {"color":"#EAA439","family":"Protein/RNP groups","group":"EJC/mRNP groups","kind":"subcomplex"}
name pdb_7DVQ_EJC_mRNP #388.1/V
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_7DVQ_NTC_NTR_related #388.1/J,R
# NTC/PRP19
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_7DVQ_NTC_PRP19 #388.1/L,P,T
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_7DVQ_RNA_substrate #388.1/G
# SR proteins
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_7DVQ_SR_proteins #388.1/U
# U11/U12 snRNP
# selector_meta {"color":"#B66AAE","family":"Protein/RNP groups","group":"U1 snRNP groups","kind":"subcomplex"}
name pdb_7DVQ_U11_U12_snRNP #388.1/H
# U2 Sm ring
# selector_meta {"color":"#BFE6BF","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_7DVQ_U2_Sm_ring #388.1/h,i,j,k,l,m,n
# U2/SF3B
# selector_meta {"color":"#6DBE70","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_7DVQ_U2_SF3B #388.1/1,2,3,4,5,6,7
# U4atac/U6atac snRNP
# selector_meta {"color":"#D8C800","family":"Protein/RNP groups","group":"U4/U6 groups","kind":"subcomplex"}
name pdb_7DVQ_U4atac_U6atac_snRNP #388.1/F
# U5 Sm ring
# selector_meta {"color":"#BFC3E8","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_7DVQ_U5_Sm_ring #388.1/a,b,c,d,e,f,g
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_7DVQ_U5_snRNP #388.1/A,B,C,D,E
# other
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_7DVQ_other #388.1/0,8,9,I,K,M,X,Y,Z,v,x,y,z
# Named selections for resolved substrate RNA features.
# 5' exon: residues -11-0, five-ss-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#FF9D00","family":"RNA","feature":"exon_5","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7DVQ_5exon #388.1/G:-11-0
# 5' splice site: residues 1-9, minor-snrna-basepair, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"five_prime_splice_site","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7DVQ_5SS #388.1/G:1-9
# intron from 5' splice site: residues 1-19;191-222, five-ss-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#303030","family":"RNA","feature":"intron","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7DVQ_intron #388.1/G:1-19,191-222
# branch point region: residues 195-206, network-scored-motif, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"branch_point_region","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7DVQ_branch_region #388.1/G:195-206
# branch point adenosine: residues 203, network-scored-motif, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"branch_point_adenosine","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7DVQ_branch_A #388.1/G:203
# Named selections for resolved snRNA functional regions.
# U12 snRNA U12/U6atac helix I partner: residues 2-11, reference-alignment, high confidence
# selector_meta {"color":"#047857","family":"RNA","feature":"U12_U6atac_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name Bact_7DVQ_U12_U6atac_helix_I_partner #388.1/H:2-11
# U12 snRNA branchpoint pairing region: residues 16-26, reference-alignment, high confidence
# selector_meta {"color":"#0B6E2D","family":"RNA","feature":"U12_branchpoint_pairing_region","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name Bact_7DVQ_U12_branchpoint_pairing_region #388.1/H:16-26
# U12 snRNA Sm site: residues 75-81, sequence-motif, medium confidence
# selector_meta {"color":"#2F8B4D","family":"RNA","feature":"U12_Sm_site","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name Bact_7DVQ_U12_Sm_site #388.1/H:75-81
# U5 snRNA loop I: residues 38-42, sequence-motif, medium confidence
# selector_meta {"color":"#1B3CD0","family":"RNA","feature":"U5_loop_I","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name Bact_7DVQ_U5_loop_I #388.1/B:38-42
# U6atac snRNA 5' splice-site recognition region: residues 11-17, reference-alignment, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6atac_5prime_5SS_recognition","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name Bact_7DVQ_U6atac_5_5SS_recognition #388.1/F:11-17
# U6atac snRNA U6atac/U12 helix I partner: residues 23-29, reference-alignment, high confidence
# selector_meta {"color":"#D0183C","family":"RNA","feature":"U6atac_U12_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name Bact_7DVQ_U6atac_U12_helix_I_partner #388.1/F:23-29
# U6atac snRNA AGC catalytic triad: residues 26-28, reference-alignment, high confidence
# selector_meta {"color":"#C91236","family":"RNA","feature":"U6atac_AGC_catalytic_triad","group":"catalytic core regions","group_key":"catalytic_core_regions","kind":"rna_feature"}
name Bact_7DVQ_U6atac_AGC_catalytic_triad #388.1/F:26-28
# U6atac snRNA internal stem-loop: residues 52-56;61-65, reference-alignment, medium confidence
# selector_meta {"color":"#D61A3D","family":"RNA","feature":"U6atac_ISL","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name Bact_7DVQ_U6atac_ISL #388.1/F:52-56,61-65
# RNA feature nucleotide display.
select #388.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues -11-0
color #388.1/G:-11-0 #FF9D00
select #388.1/G:-11-0
nucleotides sel fill
select clear
# 5'SS: residues 1-9
# intron: residues 1-19;191-222
# BP region: residues 195-206
# BP-A: residues 203
# U12/U6atac helix I: residues 2-11
color #388.1/H:2-11 #047857
select #388.1/H:2-11
nucleotides sel fill
select clear
# U12 BP pairing: residues 16-26
color #388.1/H:16-26 #0B6E2D
select #388.1/H:16-26
nucleotides sel fill
select clear
# U5 loop I: residues 38-42
color #388.1/B:38-42 #1B3CD0
select #388.1/B:38-42
nucleotides sel fill
select clear
# U6atac 5'SS recog.: residues 11-17
color #388.1/F:11-17 #DC143C
select #388.1/F:11-17
nucleotides sel fill
select clear
# U6atac/U12 helix I: residues 23-29
color #388.1/F:23-29 #D0183C
select #388.1/F:23-29
nucleotides sel fill
select clear
# U6atac AGC triad: residues 26-28
color #388.1/F:26-28 #C91236
select #388.1/F:26-28
nucleotides sel fill
select clear
# U6atac ISL: residues 52-56;61-65
color #388.1/F:52-56,61-65 #D61A3D
select #388.1/F:52-56,61-65
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #388.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/7dvq_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/7dvq_selection_browser.py
view
show nucleic
