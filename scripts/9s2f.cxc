# Lightweight ChimeraX script for 9S2F
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Original deposited chain identifiers are used.

# Shared anchor frame: 8H6L
# Structure group: #439; target model: #439.1; RNA labels: #439.2.

open 8h6l id 439.9 name 8H6L_anchor
open 9s2f id 439.1 name 9S2F
rename #439 DIS_9s2f_structure

# Align on PRPF8.
matchmaker #439.1/A to #439.9/5B
close #439.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# DHX35
color #439.1/35 #78184A
# U5 snRNA
color #439.1/5 #4F9FD3
# PRPF8
color #439.1/A #BFC3E8
# SNRNP200
color #439.1/B #AFEEEE
# EFTUD2
color #439.1/C #6495ED
# PRP8BP
color #439.1/E #E2F3F4
# GPATCH1
color #439.1/GP #E52B75
# SYF1
color #439.1/I #FF957B
# CRNKL1
color #439.1/J #FFC388
# BCAS2
color #439.1/K #FFDAB9
# CDC5L
color #439.1/L #DAA520
# SYF2
color #439.1/M #FF8C00
# BUD31
color #439.1/N #FFF584
# RBM22
color #439.1/O #DE9A52
# CWC15
color #439.1/P #FFDEAD
# AQR
color #439.1/Q #FFDAB9
# SNW1
color #439.1/R #D49F96
# PPIL1
color #439.1/S #EEE8AA
# PLRG1
color #439.1/T #F4A460
# PRPF17
color #439.1/W #FFF7C9
# WDR83
color #439.1/WD #ED6983
# CCDC12
color #439.1/Z #FAEBD7
# U5-Sm SNRPD3
color #439.1/a #B0C4DE
# U5-Sm SNRPB
color #439.1/b #B0C4DE
# U5-Sm SNRPD1
color #439.1/c #B0C4DE
# U5-Sm SNRPD2
color #439.1/d #B0C4DE
# U5-Sm SNRPE
color #439.1/e #B0C4DE
# U5-Sm SNRPF
color #439.1/f #B0C4DE
# U5-Sm SNRPG
color #439.1/g #B0C4DE
# PRPF19
color #439.1/q #FFFFAB
# PRPF19
color #439.1/r #FFFFAB
# PRPF19
color #439.1/s #FFFFAB
# PRPF19
color #439.1/t #FFFFAB
# PPIE
color #439.1/y #FFFFE0
# ISY1
color #439.1/D #FFEF8C
# INTRON
color #439.1/IN #303030
# U6 snRNA
color #439.1/6 #EF4444
# Named selections for subcomplexes using original deposited chain IDs.
# Disassembly factors
# selector_meta {"color":"#FF69B4","family":"Protein/RNP groups","group":"disassembly factors","kind":"subcomplex"}
name pdb_9S2F_Disassembly_factors #439.1/35,GP
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_9S2F_NTC_NTR_related #439.1/D,I,J,M,N,O,Q,R,S,y
# NTC/PRP19
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_9S2F_NTC_PRP19 #439.1/K,L,P,T,q,r,s,t
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_9S2F_RNA_substrate #439.1/IN
# Second step factors
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9S2F_Second_step_factors #439.1/W
# U5 Sm ring
# selector_meta {"color":"#BFC3E8","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_9S2F_U5_Sm_ring #439.1/a,b,c,d,e,f,g
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_9S2F_U5_snRNP #439.1/5,A,B,C,E
# U6 snRNP
# selector_meta {"color":"#DC143C","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_9S2F_U6_snRNP #439.1/6
# other
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9S2F_other #439.1/WD,Z
# Named selections for resolved substrate RNA features.
# intron: residues 11-20, component-name, high confidence, validation not_applicable
# selector_meta {"color":"#303030","family":"RNA","feature":"intron","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name DIS_9S2F_intron #439.1/IN:11-20
# substrate RNA: residues 11-20, component, medium confidence, validation not_applicable
# selector_meta {"color":"#303030","family":"RNA","feature":"substrate","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name DIS_9S2F_substrate #439.1/IN:11-20
# Named selections for resolved snRNA functional regions.
# U5 snRNA loop I: residues 38-42, sequence-motif, medium confidence
# selector_meta {"color":"#1B3CD0","family":"RNA","feature":"U5_loop_I","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name DIS_9S2F_U5_loop_I #439.1/5:38-42
# U6 snRNA 5' terminal stem-loop: residues 1-30, reference-alignment, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6_5prime_terminal_stem_loop","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name DIS_9S2F_U6_5_terminal_stem_loop #439.1/6:1-30
# U6 snRNA U2/U6 helix I partner: residues 35, motif-neighborhood, medium confidence
# selector_meta {"color":"#D0183C","family":"RNA","feature":"U6_U2_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name DIS_9S2F_U6_U2_helix_I_partner #439.1/6:35
# RNA feature nucleotide display.
select #439.1 & nucleic
nucleotides sel atoms
select clear
# intron: residues 11-20
# U5 loop I: residues 38-42
color #439.1/5:38-42 #1B3CD0
select #439.1/5:38-42
nucleotides sel fill
select clear
# U6 5' terminal SL: residues 1-30
color #439.1/6:1-30 #DC143C
select #439.1/6:1-30
nucleotides sel fill
select clear
# U2/U6 helix I: residues 35
color #439.1/6:35 #D0183C
select #439.1/6:35
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #439.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/9s2f_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/9s2f_selection_browser.py
view
show nucleic
