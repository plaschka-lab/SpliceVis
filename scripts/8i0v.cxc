color #395.1/c #B0C4DE
# U2-Sm SNRPD2
color #395.1/h #D5F5E3
# U5-Sm SNRPF
color #395.1/d #B0C4DE
# U2-Sm SNRPF
color #395.1/i #D5F5E3
# U5-Sm SNRPE
color #395.1/e #B0C4DE
# U2-Sm SNRPE
color #395.1/j #D5F5E3
