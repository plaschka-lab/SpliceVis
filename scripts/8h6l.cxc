# U6 snRNA LSm site: residues 102-105, terminal-region, low confidence
# selector_meta {"color":"#E33A55","family":"RNA","feature":"U6_LSm_site","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name B_8H6L_U6_LSm_site #370.1/6A:102-105
# RNA feature nucleotide display.
select #370.1 & nucleic
nucleotides sel atoms
select clear
# intron: residues 7-48
# BP region: residues 24-30
# BP-A: residues 29
# PPT: residues 35-48
# exon: residues 102-107
