# Composite ChimeraX script for Minor pre-B complex assembled from 8Y6O and 8Y7E
# Opens split deposited PDB parts together and preserves their relative orientation.
# Representative part aligned to the shared anchor: 8Y6O
# Brought partner part(s): 8Y7E


# Shared anchor frame: 8H6L
# Structure group: #349; target model: #349.1; RNA labels: #349.2.

open 8h6l id 349.9 name 8H6L_anchor
open 8y6o id 349.1 name 8Y6O
open 8y7e id 348.1 name 8Y7E
rename #348 pre_B_8y7e_structure
rename #349 pre_B_8y6o_structure

# Align on PRPF8.
matchmaker #349.1/C to #349.9/5B bring #348.1
close #349.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# mRNA
color #349.1/A #303030
# U5 snRNA
color #349.1/B #4F9FD3
# PRPF8
color #349.1/C #BFC3E8
# EFTUD2
color #349.1/D #6495ED
# SNRNP200
color #349.1/E #AFEEEE
# PRP8BP
