color #349.1/f #B0C4DE
# U4-Sm SNRPF
color #349.1/m #F7F0A6
# U1-Sm SNRPF
color #349.1/t #EAD7E8
# U5-Sm SNRPG
color #349.1/g #B0C4DE
# U4-Sm SNRPG
color #349.1/n #F7F0A6
# U1-Sm SNRPG
color #349.1/u #EAD7E8
# U4atac snRNA
