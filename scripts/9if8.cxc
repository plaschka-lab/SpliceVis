color #430.1/SJ #987352
# LT_PRC5
color #430.1/SK #7E6B95
# SNW1
color #430.1/SL #D49F96
# PPIL1
color #430.1/SN #EEE8AA
# PRPF17
color #430.1/SO #FFF7C9
# ISY1
color #430.1/SP #FFEF8C
# BCAS2
color #430.1/SS #FFDAB9
# PRPF19
color #430.1/ST #FFFFAB
# PRPF19
color #430.1/SU #FFFFAB
# PRPF19
color #430.1/SV #FFFFAB
# PRPF19
color #430.1/SW #FFFFAB
# LT_LTAP16_0490
color #430.1/TN #779E91
# LT_UNK
color #430.1/UX #929292
# LSM2
color #430.1/62 #F4A3A8
# LSM3
color #430.1/63 #F4A3A8
