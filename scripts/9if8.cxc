color #430.1/N5 #4F9FD3
# U6 snRNA
color #430.1/N6 #EF4444
# Named selections for subcomplexes using original deposited chain IDs.
# EJC/mRNP
# selector_meta {"color":"#EAA439","family":"Protein/RNP groups","group":"EJC/mRNP groups","kind":"subcomplex"}
name pdb_9IF8_EJC_mRNP #430.1/SA
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_9IF8_NTC_NTR_related #430.1/LL,LS,LT,SL,SN,SP
# NTC/PRP19
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_9IF8_NTC_PRP19 #430.1/LJ,LP,LQ,SS,ST,SU,SV,SW
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_9IF8_RNA_substrate #430.1/RN
# SL Sm ring
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9IF8_SL_Sm_ring #430.1/U1,U2,U3,UB,UE,UF,UG
# SL snRNP
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9IF8_SL_snRNP #430.1/LO
# SL substrate
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9IF8_SL_substrate #430.1/LE
# Second step factors
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9IF8_Second_step_factors #430.1/LV,SC,SD,SO
# U2 Sm ring
# selector_meta {"color":"#BFE6BF","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_9IF8_U2_Sm_ring #430.1/2H,2I,2J,24,25
# U2 snRNP
# selector_meta {"color":"#2F8B4D","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_9IF8_U2_snRNP #430.1/LD,LW,LY,N2
# U5 Sm ring
# selector_meta {"color":"#BFC3E8","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_9IF8_U5_Sm_ring #430.1/5B,5E,5F,5G,51,52,53
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_9IF8_U5_snRNP #430.1/LA,LB,LC,LN,N5
# U6 LSm
# selector_meta {"color":"#FECACA","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_9IF8_U6_LSm #430.1/62,63,64,65,66,67,A
# U6 snRNP
# selector_meta {"color":"#DC143C","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_9IF8_U6_snRNP #430.1/N6
# other
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_9IF8_other #430.1/2C,2D,LF,LG,LH,LR,LZ,SF,SJ,SK,TN,UX
# Named selections for resolved substrate RNA features.
# SL 5' exon: residues 28-39, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#FF9D00","family":"RNA","feature":"exon_5","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name P_9IF8_5exon #430.1/LE:28-39
# SL outron: residues 1-6;39-44; 40-61;72-96, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"intron","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name P_9IF8_intron #430.1/LO:40-61,72-96|#430.1/RN:1-6,39-44
# Branch-point A: residues 1, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"branch_point_adenosine","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name P_9IF8_branch_A #430.1/RN:1
# 3' splice-site AG: residues 43-44, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"three_prime_splice_site","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name P_9IF8_3SS #430.1/RN:43-44
# SL 5' splice site: residues 40-45, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"five_prime_splice_site","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name P_9IF8_5SS #430.1/LO:40-45
# Ligated pre-mRNA 3' exon: residues 40-41;57-63, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#C65D00","family":"RNA","feature":"exon_3","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name P_9IF8_3exon #430.1/LE:40-41,57-63
# RNA feature nucleotide display.
select #430.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues 28-39
color #430.1/LE:28-39 #FF9D00
select #430.1/LE:28-39
nucleotides sel fill
select clear
# intron: residues 1-6;39-44; 40-61;72-96
# BP-A: residues 1
# 3'SS: residues 43-44
# 5'SS: residues 40-45
# 3' exon: residues 40-41;57-63
color #430.1/LE:40-41,57-63 #C65D00
select #430.1/LE:40-41,57-63
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #430.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/9if8_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/9if8_selection_browser.py
view
show nucleic
