# mRNA
color #430.1/RN #303030
# U2-Sm SNRPD1
color #430.1/24 #A7D89C
# U5-Sm SNRPD1
color #430.1/51 #A9CFE8
# SNRPD1
color #430.1/U1 #B0C4DE
# U2-Sm SNRPD2
color #430.1/25 #A7D89C
# U5-Sm SNRPD2
color #430.1/52 #A9CFE8
# SNRPD2
color #430.1/U2 #B0C4DE
# LT_SM15K
color #430.1/2C #92A7BC
