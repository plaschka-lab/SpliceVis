color #430.1/2D #C7AE85
# U2-Sm SNRPE
color #430.1/2H #A7D89C
# U5-Sm SNRPE
color #430.1/5E #A9CFE8
# SNRPE
color #430.1/UE #B0C4DE
# U2-Sm SNRPF
color #430.1/2I #A7D89C
# U5-Sm SNRPF
color #430.1/5F #A9CFE8
