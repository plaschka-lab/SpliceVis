# Lightweight ChimeraX script for 7QTT
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Original deposited chain identifiers are used.

# Shared anchor frame: 8H6L
# Structure group: #389; target model: #389.1; RNA labels: #389.2.

open 8h6l id 389.9 name 8H6L_anchor
open 7qtt id 389.1 name 7QTT
rename #389 Bact_7qtt_structure

# Align on PRPF8.
matchmaker #389.1/a to #389.9/5B
close #389.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# SF3B3
color #389.1/A #487957
# SF3B5
color #389.1/B #92BB8F
# SF3B1
color #389.1/C #D5EAD0
# PHF5A
color #389.1/D #375A40
# SF3B2
color #389.1/E #49926C
# SF3B4
color #389.1/F #77B088
# GPATC5
color #389.1/G #BFC4EE
# SF3A2
color #389.1/I #75A074
# SF3A3
color #389.1/J #9BCF91
# BUD13
color #389.1/L #459285
# DBP2
color #389.1/N #E3B296
# PLRG1
color #389.1/O #F4A460
# CDC5L
color #389.1/P #DAA520
# CWC15
color #389.1/Q #FFDEAD
# BUD31
color #389.1/T #FFF584
# RBM22
color #389.1/U #DE9A52
# PPIL4
color #389.1/V #547083
# CWC22
color #389.1/W #2C54DD
# CRNKL1
color #389.1/X #FFC388
# SNW1
color #389.1/Y #D49F96
# RNF113
color #389.1/Z #6C46CE
# PRPF8
color #389.1/a #BFC3E8
# EFTUD2
color #389.1/b #6495ED
# U6 snRNA
color #389.1/d #EF4444
# U5 snRNA
color #389.1/e #4F9FD3
# U2 snRNA
color #389.1/f #71C562
# mRNA
color #389.1/g #303030
# U5-Sm SNRPF
color #389.1/h #B0C4DE
# U5-Sm SNRPE
color #389.1/i #B0C4DE
# U5-Sm SNRPD3
color #389.1/j #B0C4DE
# U5-Sm SNRPD1
color #389.1/k #B0C4DE
# U5-Sm SNRPD2
color #389.1/l #B0C4DE
# U5-Sm SNRPG
color #389.1/m #B0C4DE
# U5-Sm SNRPB
color #389.1/n #B0C4DE
# PPIL1
color #389.1/p #EEE8AA
# SRRM2
color #389.1/q #BDD6F0
# PPIL2
color #389.1/u #B12F50
# Named selections for subcomplexes using original deposited chain IDs.
# EJC/mRNP
# selector_meta {"color":"#EAA439","family":"Protein/RNP groups","group":"EJC/mRNP groups","kind":"subcomplex"}
name pdb_7QTT_EJC_mRNP #389.1/W
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_7QTT_NTC_NTR_related #389.1/T,U,X,Y,p
# NTC/PRP19
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_7QTT_NTC_PRP19 #389.1/O,P,Q
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_7QTT_RNA_substrate #389.1/g
# SR proteins
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_7QTT_SR_proteins #389.1/q
# U2 snRNP
# selector_meta {"color":"#2F8B4D","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_7QTT_U2_snRNP #389.1/f
# U2/SF3B
# selector_meta {"color":"#6DBE70","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_7QTT_U2_SF3B #389.1/A,B,C,D,E,F,I,J
# U5 Sm ring
# selector_meta {"color":"#BFC3E8","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_7QTT_U5_Sm_ring #389.1/h,i,j,k,l,m,n
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_7QTT_U5_snRNP #389.1/a,b,e
# U6 snRNP
# selector_meta {"color":"#DC143C","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_7QTT_U6_snRNP #389.1/d
# other
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_7QTT_other #389.1/G,L,N,V,Z,u
# Named selections for resolved substrate RNA features.
# 5' exon: residues -14--1, splice-site-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#FF9D00","family":"RNA","feature":"exon_5","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7QTT_5exon #389.1/g:-14--1
# 5' splice site: residues 1-6, network-scored-motif, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"five_prime_splice_site","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7QTT_5SS #389.1/g:1-6
# intron: residues 1-27;130-164, splice-site-inference, medium confidence, validation not_applicable
# selector_meta {"color":"#303030","family":"RNA","feature":"intron","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7QTT_intron #389.1/g:1-27,130-164
# branch point region: residues 138-146, network-scored-motif, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"branch_point_region","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7QTT_branch_region #389.1/g:138-146
# branch point adenosine: residues 144, network-scored-motif, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"branch_point_adenosine","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7QTT_branch_A #389.1/g:144
# polypyrimidine tract: residues 150-161, manual-review-addition, high confidence, validation validated
# selector_meta {"color":"#303030","family":"RNA","feature":"polypyrimidine_tract","group":"pre-mRNA features","group_key":"pre_mRNA_features","kind":"rna_feature"}
name Bact_7QTT_PPT #389.1/g:150-161
# Named selections for resolved snRNA functional regions.
# U2 snRNA U2/U6 helix I partner: residues 26-30, review-region, high confidence
# selector_meta {"color":"#047857","family":"RNA","feature":"U2_U6_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name Bact_7QTT_U2_U6_helix_I_partner #389.1/f:26-30
# U2 snRNA branchpoint pairing region: residues 32-41, sequence-motif-neighborhood, medium confidence
# selector_meta {"color":"#0B6E2D","family":"RNA","feature":"U2_branchpoint_pairing_region","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name Bact_7QTT_U2_branchpoint_pairing_region #389.1/f:32-41
# U2 snRNA stem IIa: residues 46-65;68-74;78-80, review-region, low confidence
# selector_meta {"color":"#167A38","family":"RNA","feature":"U2_stem_IIa","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name Bact_7QTT_U2_stem_IIa #389.1/f:46-65,68-74,78-80
# U5 snRNA loop I: residues 38-42, sequence-motif, medium confidence
# selector_meta {"color":"#1B3CD0","family":"RNA","feature":"U5_loop_I","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name Bact_7QTT_U5_loop_I #389.1/e:38-42
# U6 snRNA 5' terminal stem-loop: residues 1-30, reference-alignment, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6_5prime_terminal_stem_loop","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name Bact_7QTT_U6_5_terminal_stem_loop #389.1/d:1-30
# U6 snRNA U2/U6 helix I partner: residues 35-60, motif-neighborhood, medium confidence
# selector_meta {"color":"#D0183C","family":"RNA","feature":"U6_U2_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name Bact_7QTT_U6_U2_helix_I_partner #389.1/d:35-60
# U6 snRNA 5' splice-site upstream contact: residues 38-49, motif-neighborhood, medium confidence
# selector_meta {"color":"#E01842","family":"RNA","feature":"U6_5SS_upstream_contact","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name Bact_7QTT_U6_5SS_upstream_contact #389.1/d:38-49
# U6 snRNA ACAGAGA box: residues 41-47, sequence-motif, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6_ACAGAGA_box","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name Bact_7QTT_U6_ACAGAGA_box #389.1/d:41-47
# U6 snRNA AGC catalytic triad: residues 53-55, reference-alignment, high confidence
# selector_meta {"color":"#C91236","family":"RNA","feature":"U6_AGC_catalytic_triad","group":"catalytic core regions","group_key":"catalytic_core_regions","kind":"rna_feature"}
name Bact_7QTT_U6_AGC_catalytic_triad #389.1/d:53-55
# U6 snRNA internal stem-loop core: residues 56-79, reference-alignment, medium confidence
# selector_meta {"color":"#D61A3D","family":"RNA","feature":"U6_ISL","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name Bact_7QTT_U6_ISL #389.1/d:56-79
# U6 snRNA LSm site: residues 97, terminal-region, low confidence
# selector_meta {"color":"#E33A55","family":"RNA","feature":"U6_LSm_site","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name Bact_7QTT_U6_LSm_site #389.1/d:97
# RNA feature nucleotide display.
select #389.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues -14--1
color #389.1/g:-14--1 #FF9D00
select #389.1/g:-14--1
nucleotides sel fill
select clear
# 5'SS: residues 1-6
# intron: residues 1-27;130-164
# BP region: residues 138-146
# BP-A: residues 144
# PPT: residues 150-161
# U2/U6 helix I: residues 26-30
color #389.1/f:26-30 #047857
select #389.1/f:26-30
nucleotides sel fill
select clear
# U2 BP pairing: residues 32-41
color #389.1/f:32-41 #0B6E2D
select #389.1/f:32-41
nucleotides sel fill
select clear
# U2 stem IIa: residues 46-65;68-74;78-80
color #389.1/f:46-65,68-74,78-80 #167A38
select #389.1/f:46-65,68-74,78-80
nucleotides sel fill
select clear
# U5 loop I: residues 38-42
color #389.1/e:38-42 #1B3CD0
select #389.1/e:38-42
nucleotides sel fill
select clear
# U6 5' terminal SL: residues 1-30
color #389.1/d:1-30 #DC143C
select #389.1/d:1-30
nucleotides sel fill
select clear
# U2/U6 helix I: residues 35-60
color #389.1/d:35-60 #D0183C
select #389.1/d:35-60
nucleotides sel fill
select clear
# U6 5'SS contact: residues 38-49
color #389.1/d:38-49 #E01842
select #389.1/d:38-49
nucleotides sel fill
select clear
# U6 ACAGAGA: residues 41-47
color #389.1/d:41-47 #DC143C
select #389.1/d:41-47
nucleotides sel fill
select clear
# U6 AGC triad: residues 53-55
color #389.1/d:53-55 #C91236
select #389.1/d:53-55
nucleotides sel fill
select clear
# U6 ISL: residues 56-79
color #389.1/d:56-79 #D61A3D
select #389.1/d:56-79
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #389.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/7qtt_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/7qtt_selection_browser.py
view
show nucleic
