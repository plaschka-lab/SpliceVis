# Lightweight ChimeraX script for 6QW6
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Original deposited chain identifiers are used.

# Shared anchor frame: 8H6L
# Structure group: #334; target model: #334.1; RNA labels: #334.2.

open 8h6l id 334.9 name 8H6L_anchor
open 6qw6 id 334.1 name 6QW6
rename #334 tri_snRNP_6qw6_structure

# Align on PRPF8.
matchmaker #334.1/5A to #334.9/5B
close #334.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# SNRNP27
color #334.1/X #F4E7D2
# U4 snRNA
color #334.1/4 #F2D94E
# U4-Sm SNRPD1
color #334.1/41 #F7F0A6
# U5-Sm SNRPD1
color #334.1/51 #B0C4DE
# U4-Sm SNRPD2
color #334.1/42 #F7F0A6
# U5-Sm SNRPD2
color #334.1/52 #B0C4DE
# U4-Sm SNRPD3
color #334.1/43 #F7F0A6
# U5-Sm SNRPD3
color #334.1/53 #B0C4DE
# PRPF3
color #334.1/4A #E1DD1B
# PRPF4
color #334.1/4B #E2C496
# PRPF31
color #334.1/4C #DFD570
# NHP2L1
color #334.1/4D #A89264
# U4-Sm SNRPB
color #334.1/4b #F7F0A6
# U5-Sm SNRPB
color #334.1/5b #B0C4DE
# U4-Sm SNRPE
color #334.1/4e #F7F0A6
# U5-Sm SNRPE
color #334.1/5e #B0C4DE
# U4-Sm SNRPF
color #334.1/4f #F7F0A6
# U5-Sm SNRPF
color #334.1/5f #B0C4DE
# U4-Sm SNRPG
color #334.1/4g #F7F0A6
# U5-Sm SNRPG
color #334.1/5g #B0C4DE
# U5 snRNA
color #334.1/5 #4F9FD3
# PRPF8
color #334.1/5A #BFC3E8
# SNRNP200
color #334.1/5B #AFEEEE
# EFTUD2
color #334.1/5C #6495ED
# TXNL4A
color #334.1/5D #C3BA7A
# PRPF6
color #334.1/5J #CFA785
# PRP8BP
color #334.1/5O #E2F3F4
# DDX23
color #334.1/5X #CA9982
# U6 snRNA
color #334.1/6 #EF4444
# LSM2
color #334.1/62 #F4A3A8
# LSM3
color #334.1/63 #F4A3A8
# LSM4
color #334.1/64 #F4A3A8
# LSM5
color #334.1/65 #F4A3A8
# LSM6
color #334.1/66 #F4A3A8
# LSM7
color #334.1/67 #F4A3A8
# LSM8
color #334.1/68 #F4A3A8
# RBM42
color #334.1/R #44A0A7
# SART1
color #334.1/S #D6937B
# USP39
color #334.1/U #B37E6A
# Named selections for subcomplexes using original deposited chain IDs.
# RNA-binding
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_6QW6_RNA_binding #334.1/R
# U4 Sm ring
# selector_meta {"color":"#F5E85A","family":"Protein/RNP groups","group":"U4 snRNP groups","kind":"subcomplex"}
name pdb_6QW6_U4_Sm_ring #334.1/4b,4e,4f,4g,41,42,43
# U4 snRNP
# selector_meta {"color":"#D8C800","family":"Protein/RNP groups","group":"U4 snRNP groups","kind":"subcomplex"}
name pdb_6QW6_U4_snRNP #334.1/4
# U4/U6 snRNP
# selector_meta {"color":"#C3BA7A","family":"Protein/RNP groups","group":"U4/U6 groups","kind":"subcomplex"}
name pdb_6QW6_U4_U6_snRNP #334.1/4A,4B,4C,4D,5D,5X,U
# U5 Sm ring
# selector_meta {"color":"#BFC3E8","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_6QW6_U5_Sm_ring #334.1/5b,5e,5f,5g,51,52,53
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_6QW6_U5_snRNP #334.1/5,5A,5B,5C,5J,5O,S,X
# U6 LSm
# selector_meta {"color":"#FECACA","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_6QW6_U6_LSm #334.1/62,63,64,65,66,67,68
# U6 snRNP
# selector_meta {"color":"#DC143C","family":"Protein/RNP groups","group":"U6 snRNP groups","kind":"subcomplex"}
name pdb_6QW6_U6_snRNP #334.1/6
# Named selections for resolved snRNA functional regions.
# U4 snRNA U4/U6 stem I partner: residues 1-18, reference-alignment, high confidence
# selector_meta {"color":"#D8C800","family":"RNA","feature":"U4_U6_stem_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U4_U6_stem_I_partner #334.1/4:1-18
# U4 snRNA U4/U6 stem II partner: residues 56-64, reference-alignment, high confidence
# selector_meta {"color":"#E0CF1A","family":"RNA","feature":"U4_U6_stem_II_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U4_U6_stem_II_partner #334.1/4:56-64
# U4 snRNA Brr2 loading region: residues 59-70;73-80;85-94, review-region, low confidence
# selector_meta {"color":"#F0DF2E","family":"RNA","feature":"U4_Brr2_loading_region","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U4_Brr2_loading_region #334.1/4:59-70,73-80,85-94
# U4 snRNA Sm site: residues 118-124, sequence-motif, medium confidence
# selector_meta {"color":"#F5E85A","family":"RNA","feature":"U4_Sm_site","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U4_Sm_site #334.1/4:118-124
# U5 snRNA loop I: residues 38, sequence-motif, medium confidence
# selector_meta {"color":"#1B3CD0","family":"RNA","feature":"U5_loop_I","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U5_loop_I #334.1/5:38
# U6 snRNA U2/U6 helix I partner: residues 35-36;47-60, motif-neighborhood, medium confidence
# selector_meta {"color":"#D0183C","family":"RNA","feature":"U6_U2_helix_I_partner","group":"snRNA-snRNA interacting regions","group_key":"snRNA_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U6_U2_helix_I_partner #334.1/6:35-36,47-60
# U6 snRNA 5' splice-site upstream contact: residues 47-49, motif-neighborhood, medium confidence
# selector_meta {"color":"#E01842","family":"RNA","feature":"U6_5SS_upstream_contact","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U6_5SS_upstream_contact #334.1/6:47-49
# U6 snRNA ACAGAGA box: residues 47, sequence-motif, high confidence
# selector_meta {"color":"#DC143C","family":"RNA","feature":"U6_ACAGAGA_box","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U6_ACAGAGA_box #334.1/6:47
# U6 snRNA U4/U6 stem II partner: residues 52-61, reference-alignment, high confidence
# selector_meta {"color":"#E01842","family":"RNA","feature":"U6_U4_stem_II_partner","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U6_U4_stem_II_partner #334.1/6:52-61
# U6 snRNA U4/U6 stem I partner: residues 63-74, reference-alignment, high confidence
# selector_meta {"color":"#D9183E","family":"RNA","feature":"U6_U4_stem_I_partner","group":"other snRNA regions","group_key":"other_snRNA_regions","kind":"rna_feature"}
name U5_tri_snRNP_6QW6_U6_U4_stem_I_partner #334.1/6:63-74
# RNA feature nucleotide display.
select #334.1 & nucleic
nucleotides sel atoms
select clear
# U4/U6 stem I: residues 1-18
color #334.1/4:1-18 #D8C800
select #334.1/4:1-18
nucleotides sel fill
select clear
# U4/U6 stem II: residues 56-64
color #334.1/4:56-64 #E0CF1A
select #334.1/4:56-64
nucleotides sel fill
select clear
# U4 Brr2 region: residues 59-70;73-80;85-94
color #334.1/4:59-70,73-80,85-94 #F0DF2E
select #334.1/4:59-70,73-80,85-94
nucleotides sel fill
select clear
# U5 loop I: residues 38
color #334.1/5:38 #1B3CD0
select #334.1/5:38
nucleotides sel fill
select clear
# U2/U6 helix I: residues 35-36;47-60
color #334.1/6:35-36,47-60 #D0183C
select #334.1/6:35-36,47-60
nucleotides sel fill
select clear
# U6 5'SS contact: residues 47-49
color #334.1/6:47-49 #E01842
select #334.1/6:47-49
nucleotides sel fill
select clear
# U6 ACAGAGA: residues 47
color #334.1/6:47 #DC143C
select #334.1/6:47
nucleotides sel fill
select clear
# U4/U6 stem II: residues 52-61
color #334.1/6:52-61 #E01842
select #334.1/6:52-61
nucleotides sel fill
select clear
# U4/U6 stem I: residues 63-74
color #334.1/6:63-74 #D9183E
select #334.1/6:63-74
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #334.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/label_scripts/6qw6_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts/selection_browser_scripts/6qw6_selection_browser.py
view
show nucleic
