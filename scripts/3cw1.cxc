color #301.1/C #EAD7E8
# U1-Sm SNRPD2
color #301.1/P #EAD7E8
# U1-Sm SNRPD2
color #301.1/Q #EAD7E8
# U1-Sm SNRPD2
color #301.1/R #EAD7E8
