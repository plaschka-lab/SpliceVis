color #301.1/F #EAD7E8
# U1-Sm SNRPF
color #301.1/Z #EAD7E8
# U1-Sm SNRPE
color #301.1/E #EAD7E8
# U1-Sm SNRPE
color #301.1/W #EAD7E8
# U1-Sm SNRPE
color #301.1/X #EAD7E8
# U1-Sm SNRPE
color #301.1/Y #EAD7E8
# U1-Sm SNRPG
color #301.1/3 #EAD7E8
# U1-Sm SNRPG
color #301.1/4 #EAD7E8
# U1-Sm SNRPG
color #301.1/5 #EAD7E8
# U1-Sm SNRPG
color #301.1/G #EAD7E8
# SNRNP70
color #301.1/6 #8C3D78
# SNRNP70
color #301.1/7 #8C3D78
# SNRNP70
color #301.1/8 #8C3D78
# SNRNP70
