color #301.1/0 #D7A3CF
# SNRPC
color #301.1/9 #D7A3CF
# SNRPC
color #301.1/L #D7A3CF
# SNRPC
color #301.1/l #D7A3CF
# Named selections for subcomplexes using original deposited chain IDs.
# U1 Sm ring
# selector_meta {"color":"#B66AAE","family":"Protein/RNP groups","group":"U1 snRNP groups","kind":"subcomplex"}
name pdb_3CW1_U1_Sm_ring #301.1/1,2,3,4,5,A,B,C,D,E,F,G,H,I,J,M,N,O,P,Q,R,S,T,U,W,X,Y,Z
# U1 snRNP
# selector_meta {"color":"#B66AAE","family":"Protein/RNP groups","group":"U1 snRNP groups","kind":"subcomplex"}
name pdb_3CW1_U1_snRNP #301.1/0,6,7,8,9,K,L,V,l,v,w,x
# Named selections for resolved snRNA functional regions.
# U1 snRNA 5' splice-site recognition region: residues 1-10; 201-210; 401-410; 601-610, review-region, medium confidence
# selector_meta {"color":"#B66AAE","family":"RNA","feature":"U1_5prime_5SS_recognition","group":"snRNA-pre-mRNA regions","group_key":"snRNA_pre_mRNA_regions","kind":"rna_feature"}
name U1_snRNP_3CW1_U1_5_5SS_recognition #301.1/V:1-10|#301.1/v:201-210|#301.1/w:401-410|#301.1/x:601-610
# U1 snRNA stem-loop 1: residues 11-45; 211-245; 411-445; 611-645, review-region, low confidence
# selector_meta {"color":"#BF72B7","family":"RNA","feature":"U1_SL1","group":"internal stem loops","group_key":"internal_stem_loops","kind":"rna_feature"}
name U1_snRNP_3CW1_U1_SL1 #301.1/V:11-45|#301.1/v:211-245|#301.1/w:411-445|#301.1/x:611-645
