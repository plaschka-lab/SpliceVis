open 8qo9 id 363.1 name 8QO9
# Rename 8QO9 chains to systematic project IDs.
# Temporary safe-harbor IDs avoid collisions with deposited or target chain IDs.
changechains #363.1 2,21,22,23,2A,2B,2b,2e,2f,2g,4,41,42,43,4b,4e,4f,4g,5,51,52,53,5b,5e,5f,5g,6,62,63,64,65,66,67,68,7,8,9,A,B,B1,B2,B3,B4,B5,B6,BP,C,D,E,F,G,H,I,J,K,L,M,N,Q,S,T,W,X,Z,r,s,v,w,x,y,z TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046,TMP047,TMP048,TMP049,TMP050,TMP051,TMP052,TMP053,TMP054,TMP055,TMP056,TMP057,TMP058,TMP059,TMP060,TMP061,TMP062,TMP063,TMP064,TMP065,TMP066,TMP067,TMP068,TMP069,TMP070,TMP071 log false
changechains #363.1 TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046,TMP047,TMP048,TMP049,TMP050,TMP051,TMP052,TMP053,TMP054,TMP055,TMP056,TMP057,TMP058,TMP059,TMP060,TMP061,TMP062,TMP063,TMP064,TMP065,TMP066,TMP067,TMP068,TMP069,TMP070,TMP071 2,2S1,2S2,2S3,2K,2L,2SB,2SE,2SF,2SG,4,4S1,4S2,4S3,4SB,4SE,4SF,4SG,5,5S1,5S2,5S3,5SB,5SE,5SF,5SG,6,6L2,6L3,6L4,6L5,6L6,6L7,6L8,2H,2IA,2JA,5A,5B,2A,2B,2C,2D,2E,2F,2G,5C,6B,5E,4B,2IB,2JB,XA6,4A,XAO,4C,4D,5D,NB,5H,XP,X4,XAD,M,XCB,XBL,XBCA,XBCB,XAKA,XAKB,XB log false
open emdb:18529 id 363.3.1 name B_8qo9_EMD-18529_primary_map
rename #363 B_8qo9_structure

# Align on PRPF8.
matchmaker #363.1/5A to #363.9/5A bring #363.3.1
close #363.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts_systematic_with_primary_maps/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
