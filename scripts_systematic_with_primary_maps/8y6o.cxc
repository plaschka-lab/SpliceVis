name pre_B_8Y6O_U6atac_ISL #342.1/6AT:52-58,60-65
# RNA feature nucleotide display.
select #342.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues -1-0
color #342.1/M:-1-0 #FF8C00
select #342.1/M:-1-0
nucleotides sel fill
select clear
# 5'SS: residues 1-10
# intron: residues 1-11
# U11 5'SS recog.: residues 1-7
color #342.1/11:1-7 #B66AAE
select #342.1/11:1-7
nucleotides sel fill
select clear
# U11 SL1: residues 11-39;43-45
color #342.1/11:11-39,43-45 #BF72B7
select #342.1/11:11-39,43-45
nucleotides sel fill
select clear
# U11 SL2: residues 46-95
color #342.1/11:46-95 #AD62A6
select #342.1/11:46-95
nucleotides sel fill
select clear
# U4atac/U6atac stem I: residues 3-18
color #342.1/4AT:3-18 #D8C800
select #342.1/4AT:3-18
nucleotides sel fill
select clear
# U4atac/U6atac stem II: residues 60-64
color #342.1/4AT:60-64 #E0CF1A
select #342.1/4AT:60-64
nucleotides sel fill
select clear
# U4atac Brr2 region: residues 83-96
color #342.1/4AT:83-96 #F0DF2E
select #342.1/4AT:83-96
nucleotides sel fill
select clear
# U5 loop I: residues 38-42
color #342.1/5:38-42 #1B3CD0
select #342.1/5:38-42
nucleotides sel fill
select clear
# U6atac/U12 helix I: residues 23-29
color #342.1/6AT:23-29 #D0183C
select #342.1/6AT:23-29
nucleotides sel fill
select clear
# U6atac AGC triad: residues 26-28
color #342.1/6AT:26-28 #C91236
select #342.1/6AT:26-28
nucleotides sel fill
select clear
# U6atac ISL: residues 52-58;60-65
color #342.1/6AT:52-58,60-65 #D61A3D
select #342.1/6AT:52-58,60-65
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #342.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts_systematic_with_primary_maps/label_scripts/8y6o_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts_systematic_with_primary_maps/selection_browser_scripts/8y6o_selection_browser.py
view
show nucleic
