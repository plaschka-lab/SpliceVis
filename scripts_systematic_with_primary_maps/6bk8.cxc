open 6bk8 id 423.1 name 6BK8
# Rename 6BK8 chains to systematic project IDs.
# Temporary safe-harbor IDs avoid collisions with deposited or target chain IDs.
changechains #423.1 2,5,6,A,B,D,E,F,G,H,I,K,L,M,N,O,P,R,S,T,U,X,Y,a,b,c,d,e,f,g,h,i,k,l,m,n,o,p,q,r,s,u,v,w,x,y TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046 log false
changechains #423.1 TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046 2,5,6,5A,5C,N3,NW,NM,NQ,N5,NB,RB,J5,C2,XB5,C1,C3,NF,N2,NR,NY,XBYA,XBYB,5S2,5SF,5SE,5SG,MA,5SB,5S3,5S1,MB,2SB,2SE,2SF,2SG,2S3,2S1,2S2,2KA,2KB,N1A,N1B,N1C,N1D,N4 log false
open emdb:7109 id 423.3.1 name P_6bk8_EMD-7109_primary_map
rename #423 P_6bk8_structure

# Align on PRPF8.
matchmaker #423.1/5A to #423.9/5A bring #423.3.1
close #423.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts_systematic_with_primary_maps/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
