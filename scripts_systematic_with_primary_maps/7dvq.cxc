# RNA feature nucleotide display.
select #383.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues -11-0
color #383.1/M:-11-0 #FF8C00
select #383.1/M:-11-0
nucleotides sel fill
select clear
# 5'SS: residues 1-9
# intron: residues 1-19;191-222
# BP region: residues 195-206
# BP-A: residues 203
# U12/U6atac helix I: residues 2-11
color #383.1/12:2-11 #047857
select #383.1/12:2-11
nucleotides sel fill
select clear
# U12 BP pairing: residues 16-26
color #383.1/12:16-26 #0B6E2D
select #383.1/12:16-26
nucleotides sel fill
select clear
# U5 loop I: residues 38-42
color #383.1/5:38-42 #1B3CD0
select #383.1/5:38-42
nucleotides sel fill
select clear
# U6atac 5'SS recog.: residues 11-17
color #383.1/6AT:11-17 #DC143C
select #383.1/6AT:11-17
nucleotides sel fill
select clear
# U6atac/U12 helix I: residues 23-29
color #383.1/6AT:23-29 #D0183C
select #383.1/6AT:23-29
nucleotides sel fill
select clear
# U6atac AGC triad: residues 26-28
color #383.1/6AT:26-28 #C91236
select #383.1/6AT:26-28
nucleotides sel fill
select clear
# U6atac ISL: residues 52-56;61-65
color #383.1/6AT:52-56,61-65 #D61A3D
select #383.1/6AT:52-56,61-65
nucleotides sel fill
select clear
# RNA feature 3D residue labels.
# Labels are created as independent grouped models under #383.2.
# Fetch and run the self-contained RNA label script from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts_systematic_with_primary_maps/label_scripts/7dvq_rna_labels.py
# Searchable named selection browser.
# In GUI ChimeraX this opens a small panel for selecting, zooming, and toggling RNA labels.
# Fetch and open the self-contained named selection browser from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts_systematic_with_primary_maps/selection_browser_scripts/7dvq_selection_browser.py
view
show nucleic
