# Universal spliceosome coloring for renamed systematic-chain CIFs.
# Generated by generate_universal_spliceosome_coloring.py.
# Load renamed CIFs first, then open or run this script.
# All selectors and colors below omit model IDs, so they apply to all open renamed models.

color byhetero

# Named selections by subcomplex.
# Disassembly factors
name spliceosome_Disassembly_factors /D1,D2,D5,D6
# EJC/mRNP
name spliceosome_EJC_mRNP /J1,J2,J3,J4,J5
# NTC/NTR related
name spliceosome_NTC_NTR_related /NA,NB,NC,NF,NI,NL,NM,NP,NQ,NR,NW,NY
# NTC/PRP19
name spliceosome_NTC_PRP19 /N1A,N1B,N1C,N1D,N2,N3,N4,N5
# RNA-binding
name spliceosome_RNA_binding /RA,RC
# RNA/substrate
name spliceosome_RNA_substrate /I,IA,IB,IC,M,MA,MB,MC,MD
# SR proteins
name spliceosome_SR_proteins /RB
# Second step factors
name spliceosome_Second_step_factors /C1,C2,C3
# Sm ring
name spliceosome_Sm_ring /SA,SAA,SAB,SAC,SB,SBA,SBB,SC,SCA,SCB,SD,SDA,SDB,SE,SEA,SEB,SEC,SF,SFA,SFB,SFC,SG,SGA,SGB
# U1 Sm ring
name spliceosome_U1_Sm_ring /1S1,1S2,1S3,1SB,1SE,1SF,1SG
# U1 snRNP
name spliceosome_U1_snRNP /1,1A,1B,1C,1D,1E,1G,1H,1I,1J,1K
# U11/U12 snRNP
name spliceosome_U11_U12_snRNP /11,12
# U2 Sm ring
name spliceosome_U2_Sm_ring /2S1,2S2,2S3,2SB,2SE,2SF,2SG
# U2 snRNP
name spliceosome_U2_snRNP /2,2K,2KA,2KB,2L,2M,2N,2O,2P,2Q,2R
# U2/SF3B
name spliceosome_U2_SF3B /2A,2B,2C,2D,2E,2F,2FA,2FB,2G,2H,2I,2IA,2IB,2J,2JA,2JB
# U4 Sm ring
name spliceosome_U4_Sm_ring /4S1,4S2,4S3,4SB,4SE,4SF,4SG
# U4 snRNP
name spliceosome_U4_snRNP /4
# U4/U6 snRNP
name spliceosome_U4_U6_snRNP /4A,4B,4BA,4BB,4C,4D,6A,6B,6C
# U4atac/U6atac snRNP
name spliceosome_U4atac_U6atac_snRNP /4AT,6AT
# U5 Sm ring
name spliceosome_U5_Sm_ring /5S1,5S2,5S3,5SB,5SE,5SF,5SG
# U5 snRNP
name spliceosome_U5_snRNP /5,5A,5B,5C,5D,5E,5F,5G,5H,5I
# U6 LSm
name spliceosome_U6_LSm /6L2,6L3,6L4,6L5,6L6,6L7,6L8
# U6 snRNP
name spliceosome_U6_snRNP /6,6R1,6R2
# other
name spliceosome_other /X0,X1,X2,X3,X4,X5,X6,X7,X8,X9,XA,XA0,XA1,XA2,XA3,XA4,XA5,XA6,XA7,XA8,XA9,XAA,XAB,XAC,XAD,XAE,XAF,XAG,XAH,XAI,XAJ,XAK,XAKA,XAKB,XAL,XAM,XAN,XAO,XAP,XAQ,XAR,XAS,XAT,XAU,XAV,XAW,XAX,XAY,XAZ,XB,XB0,XB1,XB2,XB3,XB4,XB5,XB6,XB7,XB8,XB9,XBA,XBB,XBC,XBCA,XBCB,XBD,XBE,XBF,XBG,XBH,XBI,XBJ,XBK,XBL,XBM,XBN,XBO,XBP,XBQ,XBR,XBS,XBT,XBU,XBV,XBW,XBXA,XBXB,XBY,XBZ,XCA,XCB,XD,XEA,XEB,XF,XG,XH,XI,XJ,XK,XL,XM,XN,XO,XP,XQ,XR,XS,XT,XU,XV,XW,XX,XY,XZ

