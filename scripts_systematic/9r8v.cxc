open 9r8v id 379.1 name 9R8V
# Rename 9R8V chains to systematic project IDs.
# Temporary safe-harbor IDs avoid collisions with deposited or target chain IDs.
changechains #379.1 2,21,22,23,2A,2B,2b,2e,2f,2g,5,51,52,53,5A,5b,5e,5f,5g,6,62,63,64,65,66,67,68,7,8,9,A,A6,B,B1,B2,B3,B4,B5,B6,BL,C,DH,E,G,I,K,L,P,P7,Q,R,S1,SR,T,X,Z,q,r,t,v,w,x,y TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046,TMP047,TMP048,TMP049,TMP050,TMP051,TMP052,TMP053,TMP054,TMP055,TMP056,TMP057,TMP058,TMP059,TMP060,TMP061,TMP062,TMP063 log false
changechains #379.1 TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046,TMP047,TMP048,TMP049,TMP050,TMP051,TMP052,TMP053,TMP054,TMP055,TMP056,TMP057,TMP058,TMP059,TMP060,TMP061,TMP062,TMP063 2,2S1,2S2,2S3,2K,2L,2SB,2SE,2SF,2SG,5,5S1,5S2,5S3,2G,5SB,5SE,5SF,5SG,6,6L2,6L3,6L4,6L5,6L6,6L7,6L8,2H,2I,2J,XA3,XB,5B,2A,2B,2C,2D,2E,2F,XL,5C,2R,5E,N3,XA7,XAP,N2,NM,C2,NB,N5,NW,XAN,XP,XAU,M,XBM,XCD,XAY,XBDA,XBDB,XALA,XALB log false
rename #379 pre_Bact_9r8v_structure

# Align on SF3B1.
matchmaker #379.1/2A to #379.9/2A
close #379.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts_systematic/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
