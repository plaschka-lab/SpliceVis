color #401.1/NM #DE9A52
# NTC/PRP19: CDC5L
color #401.1/N2 #DAA520
# NTC/PRP19: CWC15
color #401.1/N5 #FFDEAD
# SR proteins: SRRM2
color #401.1/RB #BDD6F0
# NTC/NTR related: CRNKL1
color #401.1/NR #FFC388
# NTC/NTR related: SYF1
color #401.1/NY #FF957B
# U5 Sm ring: U5-Sm SNRPB
color #401.1/5SB #B0C4DE
# U2 Sm ring: U2-Sm SNRPB
color #401.1/2SB #D5F5E3
# U5 Sm ring: U5-Sm SNRPD3
color #401.1/5S3 #B0C4DE
# U2 Sm ring: U2-Sm SNRPD3
color #401.1/2S3 #D5F5E3
# U5 Sm ring: U5-Sm SNRPE
color #401.1/5SE #B0C4DE
# U2 Sm ring: U2-Sm SNRPE
color #401.1/2SE #D5F5E3
# U5 Sm ring: U5-Sm SNRPF
color #401.1/5SF #B0C4DE
# U2 Sm ring: U2-Sm SNRPF
color #401.1/2SF #D5F5E3
# U5 Sm ring: U5-Sm SNRPG
color #401.1/5SG #B0C4DE
# U2 Sm ring: U2-Sm SNRPG
color #401.1/2SG #D5F5E3
# U5 Sm ring: U5-Sm SNRPD1
color #401.1/5S1 #B0C4DE
# U2 Sm ring: U2-Sm SNRPD1
color #401.1/2S1 #D5F5E3
# U5 Sm ring: U5-Sm SNRPD2
color #401.1/5S2 #B0C4DE
# U2 Sm ring: U2-Sm SNRPD2
color #401.1/2S2 #D5F5E3
# U2 snRNP: SNRPA1
color #401.1/2K #58D68D
# U2 snRNP: SNRPB2
color #401.1/2L #DAF7A6
# other: DDX38
color #401.1/X6 #5F2E8A
# NTC/PRP19: PRPF19
color #401.1/N1A #FFFFAB
# NTC/PRP19: PRPF19
color #401.1/N1B #FFFFAB
# NTC/PRP19: PRPF19
color #401.1/N1C #FFFFAB
# NTC/PRP19: PRPF19
color #401.1/N1D #FFFFAB
# NTC/PRP19: BCAS2
color #401.1/N4 #FFDAB9
# Named selections for systematic-chain subcomplexes.
# EJC/mRNP
# selector_meta {"color":"#EAA439","family":"Protein/RNP groups","group":"EJC/mRNP groups","kind":"subcomplex"}
name pdb_5LJ5_EJC_mRNP #401.1/J5
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
