# Lightweight ChimeraX script for 5MPS
# Models are downloaded directly by ChimeraX from the PDB.
# Primary maps, when requested, are downloaded directly from EMDB.
# Deposited chains are renamed in-session to systematic project IDs.

# Shared anchor frame: 8H6L
# Structure group: #408; target model: #408.1; RNA labels: #408.2.

open 8h6l id 408.9 name 8H6L_anchor
# Rename 8H6L_anchor chains to systematic project IDs.
# Temporary safe-harbor IDs avoid collisions with deposited or target chain IDs.
changechains #408.9 2A,2B,2C,2D,2E,2F,2G,2H,2I,2J,2K,2L,2M,2a,2b,2c,2d,2e,2f,2g,4A,4B,4C,4D,4E,4F,4G,4H,4I,4J,4Z,4a,4b,4c,4d,4e,4f,4g,5A,5B,5C,5D,5E,5a,5b,5c,5d,5e,5f,5g,6A,6a,6b,6c,6d,6e,6f,6g,A TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046,TMP047,TMP048,TMP049,TMP050,TMP051,TMP052,TMP053,TMP054,TMP055,TMP056,TMP057,TMP058,TMP059 log false
changechains #408.9 TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046,TMP047,TMP048,TMP049,TMP050,TMP051,TMP052,TMP053,TMP054,TMP055,TMP056,TMP057,TMP058,TMP059 2,2K,2L,2H,2I,2J,2A,2B,2C,2D,2F,2G,2E,2SB,2S1,2S2,2SF,2SE,2SG,2S3,4,4A,4B,4C,4D,6B,5D,X4,XAD,5H,XBC,4SB,4S1,4S2,4SF,4SE,4SG,4S3,5,5A,5C,5B,5E,5SB,5S1,5S2,5SF,5SE,5SG,5S3,6,6L2,6L3,6L4,6L5,6L6,6L7,6L8,M log false
open 5mps id 408.1 name 5MPS
# Rename 5MPS chains to systematic project IDs.
# Temporary safe-harbor IDs avoid collisions with deposited or target chain IDs.
changechains #408.1 2,5,6,A,C,E,H,I,J,K,L,M,N,O,P,R,S,T,X,a,b,c,d,e,f,g,h,j,o,y TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030 log false
changechains #408.1 TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030 2,5,6,5A,5C,M,J5,I,N3,NW,NB,NQ,NM,N2,N5,RB,NR,NY,XBS,XB4,5SB,C1,5S3,5SE,5SF,5SG,5S1,5S2,C2,NF log false
rename #408 Cstar_5mps_structure

# Align on PRPF8.
matchmaker #408.1/5A to #408.9/5A
close #408.9

# Remove implausibly long deposited covalent bonds before styling.
# Fetch and run the implausible-bond pruning helper from GitHub.
open https://raw.githubusercontent.com/plaschka-lab/SpliceVis/main/scripts_systematic/prune_implausible_bonds.py

hide atoms
cartoon
# Default display style.
style (protein|nucleic|solvent) & @@draw_mode=0 stick
cartoon style modeh def arrows t arrowshelix f arrowscale 3 wid 4 thick 3 sides 12 div 20
cartoon style ~(nucleic|strand) x round
cartoon style (nucleic|strand) x rect
cartoon style nucleic x round width 4 thick 4
lighting shadows false
lighting simple
camera ortho
lighting soft intensity 0.2 fillIntensity 0.5 ambientIntensity 1
lighting soft

# bg and model colors
set bgColor white
style nucleic stick
graphics silhouettes true
cartoon style arrowScale 1.5
color byhetero
# Subunit colors from color_code/subunit_color_code.csv.
# RNA/substrate: INTRON
color #408.1/I #303030
# RNA/substrate: EXON
color #408.1/M #303030
# U2 snRNP: U2 snRNA
color #408.1/2 #71C562
# U6 snRNP: U6 snRNA
color #408.1/6 #EF4444
# U5 snRNP: U5 snRNA
color #408.1/5 #4F9FD3
# U5 snRNP: PRPF8
color #408.1/5A #BFC3E8
# U5 snRNP: EFTUD2
color #408.1/5C #6495ED
# EJC/mRNP: CWC22
color #408.1/J5 #2C54DD
# NTC/PRP19: PLRG1
color #408.1/N3 #F4A460
# NTC/NTR related: SNW1
color #408.1/NW #D49F96
# NTC/NTR related: BUD31
color #408.1/NB #FFF584
# NTC/NTR related: CWC2
color #408.1/NQ #E6B566
# NTC/NTR related: RBM22
color #408.1/NM #DE9A52
# NTC/PRP19: CDC5L
color #408.1/N2 #DAA520
# NTC/PRP19: CWC15
color #408.1/N5 #FFDEAD
# SR proteins: SRRM2
color #408.1/RB #BDD6F0
# NTC/NTR related: CRNKL1
color #408.1/NR #FFC388
# NTC/NTR related: SYF1
color #408.1/NY #FF957B
# Second step factors: SLU7
color #408.1/C1 #5A338B
# Second step factors: PRPF17
color #408.1/C2 #FFF7C9
# NTC/NTR related: SYF2
color #408.1/NF #FF8C00
# U5 Sm ring: U5-Sm SNRPB
color #408.1/5SB #B0C4DE
# U5 Sm ring: U5-Sm SNRPD3
color #408.1/5S3 #B0C4DE
# U5 Sm ring: U5-Sm SNRPE
color #408.1/5SE #B0C4DE
# U5 Sm ring: U5-Sm SNRPF
color #408.1/5SF #B0C4DE
# U5 Sm ring: U5-Sm SNRPG
color #408.1/5SG #B0C4DE
# U5 Sm ring: U5-Sm SNRPD1
color #408.1/5S1 #B0C4DE
# U5 Sm ring: U5-Sm SNRPD2
color #408.1/5S2 #B0C4DE
# Named selections for systematic-chain subcomplexes.
# EJC/mRNP
# selector_meta {"color":"#EAA439","family":"Protein/RNP groups","group":"EJC/mRNP groups","kind":"subcomplex"}
name pdb_5MPS_EJC_mRNP #408.1/J5
# NTC/NTR related
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_5MPS_NTC_NTR_related #408.1/NB,NF,NM,NQ,NR,NW,NY
# NTC/PRP19
# selector_meta {"color":"#F4BF67","family":"Protein/RNP groups","group":"NTC/NTR groups","kind":"subcomplex"}
name pdb_5MPS_NTC_PRP19 #408.1/N2,N3,N5
# RNA/substrate
# selector_meta {"color":"#303030","family":"RNA","group":"pre-mRNA features","kind":"subcomplex"}
name pdb_5MPS_RNA_substrate #408.1/I,M
# SR proteins
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_5MPS_SR_proteins #408.1/RB
# Second step factors
# selector_meta {"color":"#9CA3AF","family":"Protein/RNP groups","group":"other protein/RNP groups","kind":"subcomplex"}
name pdb_5MPS_Second_step_factors #408.1/C1,C2
# U2 snRNP
# selector_meta {"color":"#2F8B4D","family":"Protein/RNP groups","group":"U2/SF3B groups","kind":"subcomplex"}
name pdb_5MPS_U2_snRNP #408.1/2
# U5 Sm ring
# selector_meta {"color":"#BFC3E8","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
name pdb_5MPS_U5_Sm_ring #408.1/5S1,5S2,5S3,5SB,5SE,5SF,5SG
# U5 snRNP
# selector_meta {"color":"#0000CD","family":"Protein/RNP groups","group":"U5 snRNP groups","kind":"subcomplex"}
