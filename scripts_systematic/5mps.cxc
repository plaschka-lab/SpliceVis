# RNA feature nucleotide display.
select #408.1 & nucleic
nucleotides sel atoms
select clear
# 5' exon: residues -16--1
color #408.1/M:-16--1 #FF8C00
select #408.1/M:-16--1
nucleotides sel fill
select clear
# 5'SS: residues 1-6
# intron: residues 1-16;56-73
# BP region: residues 56-73
# BP-A: residues 70
# U2/U6 helix I: residues 26-30
color #408.1/2:26-30 #047857
select #408.1/2:26-30
nucleotides sel fill
select clear
# U2 BP pairing: residues 33-42
color #408.1/2:33-42 #0B6E2D
select #408.1/2:33-42
nucleotides sel fill
select clear
# U2 stem IIa: residues 46-49
color #408.1/2:46-49 #167A38
select #408.1/2:46-49
nucleotides sel fill
select clear
# U5 loop I: residues 53
color #408.1/5:53 #1B3CD0
select #408.1/5:53
nucleotides sel fill
select clear
# U6 5' terminal SL: residues 1-10;16-30
color #408.1/6:1-10,16-30 #DC143C
select #408.1/6:1-10,16-30
nucleotides sel fill
select clear
# U2/U6 helix I: residues 41-66
color #408.1/6:41-66 #D0183C
select #408.1/6:41-66
nucleotides sel fill
select clear
# U6 5'SS contact: residues 44-55
color #408.1/6:44-55 #E01842
