open 6qx9 id 347.1 name 6QX9
# Rename 6QX9 chains to systematic project IDs.
# Temporary safe-harbor IDs avoid collisions with deposited or target chain IDs.
changechains #347.1 1,11,12,13,1A,1C,1K,1b,1e,1f,1g,2,21,22,23,2A,2B,2b,2e,2f,2g,4,41,42,43,4A,4B,4C,4D,4b,4e,4f,4g,5,51,52,53,5A,5B,5C,5D,5J,5O,5X,5b,5e,5f,5g,6,62,63,64,65,66,67,68,A1,A2,A3,B1,B2,B3,B4,B5,BP,I,K,R,S,U,X TMP001,TMP002,TMP003,TMP004,TMP005,TMP006,TMP007,TMP008,TMP009,TMP010,TMP011,TMP012,TMP013,TMP014,TMP015,TMP016,TMP017,TMP018,TMP019,TMP020,TMP021,TMP022,TMP023,TMP024,TMP025,TMP026,TMP027,TMP028,TMP029,TMP030,TMP031,TMP032,TMP033,TMP034,TMP035,TMP036,TMP037,TMP038,TMP039,TMP040,TMP041,TMP042,TMP043,TMP044,TMP045,TMP046,TMP047,TMP048,TMP049,TMP050,TMP051,TMP052,TMP053,TMP054,TMP055,TMP056,TMP057,TMP058,TMP059,TMP060,TMP061,TMP062,TMP063,TMP064,TMP065,TMP066,TMP067,TMP068,TMP069,TMP070,TMP071 log false
